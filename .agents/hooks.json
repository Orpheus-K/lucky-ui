{
  "lucky-ui-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-pre-tool.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
          "command": "node scripts/check-delivery-stop.cjs",
        "timeout": 10
      }
    ]
  }
}
